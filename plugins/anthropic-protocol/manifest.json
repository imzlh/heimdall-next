{
    "id": "heimdall.protocol.anthropic",
    "version": "0.1.0",
    "apiVersion": "1",
    "name": "Anthropic Messages HTTP protocol",
    "kind": "protocol",
    "trust": "trusted",
    "capabilities": ["anthropic.messages", "streaming", "tools"],
    "routes": [
        {
            "method": "POST",
            "path": "/v1/messages",
            "operation": "generation.create"
        }
    ],
    "permissions": {
        "network": false,
        "filesystem": "none",
        "subprocess": false
    }
}

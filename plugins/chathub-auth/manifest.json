{
    "id": "heimdall.api.chathub-auth",
    "version": "0.1.0",
    "apiVersion": "1",
    "name": "Microsoft ChatHub login",
    "kind": "api",
    "trust": "trusted",
    "permissions": {
        "network": true,
        "filesystem": "none",
        "subprocess": false
    },
    "routes": [
        {
            "method": "POST",
            "path": "/admin/plugins/chathub/auth",
            "operation": "chathub.auth"
        }
    ]
}
